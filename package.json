{
  "name": "musou-slice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/precache.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "playwright test e2e/benchmark.spec.ts",
    "format": "prettier --write src tests e2e scripts *.ts package.json index.html public .github README.md",
    "art:generate": "node scripts/generate-characters.mjs",
    "art:report": "node scripts/art-report.mjs",
    "art:validate": "node scripts/validate-characters.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/loaders": "^8.56.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "gltf-validator": "^2.0.0-dev.3.10",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
